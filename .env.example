# Supabase Local（npx supabase start 起動後の表示を貼り付け）
NEXT_PUBLIC_SUPABASE_URL="http://127.0.0.1:54321"
# 新キー（推奨）: supabase status の "Publishable key"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="<supabase status の Publishable key>"
# 旧キー（フォールバック・2026末 deprecated）。新キーが無い場合のみ使用:
# NEXT_PUBLIC_SUPABASE_ANON_KEY="<anon key>"

# サーバー専用（絶対に NEXT_PUBLIC_ を付けないこと）
# 新キー（推奨）: supabase status の "Secret key"
SUPABASE_SECRET_KEY="<supabase status の Secret key>"
# 旧キー（フォールバック）:
# SUPABASE_SERVICE_ROLE_KEY="<service_role key>"

# Drizzle（Supabase Local の DB 接続文字列）
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"
